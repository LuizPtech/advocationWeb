generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("CLIENT")
  phone        String?
  cpf          String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cases        Case[]
  bookings     Booking[]
  messages     Message[]
  documents    Document[]
  payments     Payment[]
  notes        Note[]
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  area        String?
  lgpdConsent Boolean  @default(false)
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
}

model Booking {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  type        String
  area        String
  notes       String?
  scheduledAt DateTime
  status      String   @default("PENDING")
  lgpdConsent Boolean  @default(false)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Case {
  id          String     @id @default(cuid())
  title       String
  description String?
  area        String
  status      String     @default("OPEN")
  nextStep    String?
  deadline    DateTime?
  tags        String     @default("[]")
  clientId    String
  client      User       @relation(fields: [clientId], references: [id])
  documents   Document[]
  messages    Message[]
  payments    Payment[]
  notes       Note[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Document {
  id              String   @id @default(cuid())
  name            String
  filename        String
  mimeType        String
  size            Int
  path            String
  visibleToClient Boolean  @default(true)
  caseId          String?
  case            Case?    @relation(fields: [caseId], references: [id])
  uploadedById    String
  uploadedBy      User     @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  body      String
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Payment {
  id          String    @id @default(cuid())
  description String
  amount      Float
  status      String    @default("PENDING")
  dueDate     DateTime?
  paidAt      DateTime?
  receiptUrl  String?
  caseId      String?
  case        Case?     @relation(fields: [caseId], references: [id])
  clientId    String
  client      User      @relation(fields: [clientId], references: [id])
  createdAt   DateTime  @default(now())
}

model Note {
  id        String   @id @default(cuid())
  body      String
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  area        String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AvailabilitySlot {
  id        String  @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
  active    Boolean @default(true)
}

model SiteSettings {
  id        String   @id @default("default")
  name      String
  shortName String
  title     String
  oab       String
  tagline   String
  headline  String
  about     String
  email     String
  phone     String
  whatsapp  String
  address   String
  city      String
  updatedAt DateTime @updatedAt
}
